FASTPRIZE_IMAGE=fastprize:local
FASTPRIZE_PORT=5001
FASTPRIZE_SESSION_SECRET=
FASTPRIZE_COOKIE_SECURE=true
FORWARDED_ALLOW_IPS=

# Local/self-hosted bootstrap. Used only when the database has no admin.
# Leave both empty when SETUP_TOKEN or SETUP_TOKEN_HASH is set.
FASTPRIZE_ADMIN_EMAIL=
FASTPRIZE_ADMIN_PASSWORD=

# One-time hosted setup. The tenant opens /setup?token=... and chooses
# the admin email and password. The token is stored hashed and spent on claim.
# Set SETUP_TOKEN to the secret, SETUP_TOKEN=generate to print one on first boot,
# or SETUP_TOKEN_HASH to the sha256 hex digest of the secret. Set only one.
SETUP_TOKEN=
SETUP_TOKEN_HASH=

# Password reset email via the Resend API. Leave RESEND_API_KEY empty to
# keep email reset disabled; admins can still use fastprize-admin reset-password.
RESEND_API_KEY=
RESEND_FROM=FastPrize <hello@fastprize.net>
# Public https origin used in reset links. http is accepted only for localhost.
# When unset, a same-origin request Origin header is used instead.
APP_BASE_URL=

# Seed dummy_data/ once on first boot for demo instances. true, 1, or yes.
SEED_DUMMY_DATA=

# Link shown in the admin panel. Invalid values fall back to the default.
BILLING_URL=https://fastprize.net/billing
